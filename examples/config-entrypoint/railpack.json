{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "entrypoint": [
      "mise",
      "exec",
      "--",
      "bash",
      "-c"
    ],
    "startCommand": "python main.py",
    "healthcheck": {
      "url": "http://127.0.0.1:${PORT}/",
      "interval": "1s",
      "timeout": "3s"
    }
  }
}
