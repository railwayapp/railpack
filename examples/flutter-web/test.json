[
  {
    // Flutter publishes Linux SDK archives for x64 only, so the build cannot run on arm64.
    // Skip on ARM: GHA arm runners emulate amd64 via QEMU, and the Flutter web build does not
    // finish within the 20m test timeout. Covered on native amd64 CI.
    "platform": "linux/amd64",
    "skipArch": ["arm64"],
    "httpCheck": {
      "path": "/",
      "expected": 200,
      "internalPort": 80,
      // Flutter renders into a canvas, so assert against the shell HTML
      "expectedOutput": "Railpack Flutter Web"
    }
  },
  {
    "platform": "linux/amd64",
    "skipArch": ["arm64"],
    // index fallback is on by default so client-side routes resolve
    "httpCheck": {
      "path": "/some/client/route",
      "expected": 200,
      "internalPort": 80,
      "expectedOutput": "Railpack Flutter Web"
    }
  }
]
