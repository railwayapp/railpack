{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "python": "latest"
  },
  "steps": {
    "build": {
      "commands": ["neofetch"],
      "variables": {
        "HELLO": "world"
      }
    }
  },
  "deploy": {
    "inputs": ["..."],
    "startCommand": "python --version && neofetch $HELLO"
  }
}
