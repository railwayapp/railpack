[
  {
    // Environment.Version reports the bundled .NET Runtime version (6.0.36 for the default 6.0.428 SDK)
    "expectedOutput": "Hello from dotnet 6.0.36"
  },
  {
    "envs": {
      "RAILPACK_DOTNET_VERSION": "8.0.404"
