{
  "$schema": "../../test/schema.json",

  "secrets": ["HELLO_WORLD"],

  "steps": {
    "usesSecrets": {
      "commands": [
        { "src": ".", "dest": "." },
        "./run.sh MY_SECRET MY_OTHER_SECRET NOT_SECRET"
      ],
      "secrets": ["MY_SECRET", "MY_OTHER_SECRET"],
      "variables": {
        "NOT_SECRET": "not secret"
      }
    },

    "defaultsToUsing": {
      "commands": [
        { "src": ".", "dest": "." },
        "./run.sh HELLO_WORLD NOT_SECRET"
      ],
      "secrets": ["*"],
      "variables": {
        "NOT_SECRET": "not secret"
      }
    }
  },

  "deploy": {
    "startCommand": "echo secrets-build-succeeded"
  }
}
