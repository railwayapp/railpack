#!/usr/bin/env bash
#MISE description="Test 'railpack info' CLI output on an example"

set -euo pipefail

# cli-e2e sets this to an examples/ directory basename.
example_dir="examples/$EXAMPLE_PROJECT_NAME"
echo "Testing info with: $example_dir"

tmp_dir="tmp/test-integration/info"
mkdir -p "$tmp_dir"

mise run cli info "$example_dir" --format json --out "$tmp_dir/info.json"
jq -e '.success == true' "$tmp_dir/info.json" > /dev/null
jq -e '.resolvedPackages != null' "$tmp_dir/info.json" > /dev/null

mise run cli info "$example_dir" --format pretty --show-plan > /dev/null
