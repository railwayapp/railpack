# shellcheck shell=bash
# description: verifies from the BuildKit log that --no-cache reran executable commands
#
# - $1 is the generated Railpack plan JSON path and $2 is the BuildKit rawjson log path
# - the plan only identifies execution steps through entries with a `cmd` field,
#   using `customName` as the vertex name when present
# - image pulls and file operations have no `cmd` entry, so their cached status is ignored
# - the log supplies execution evidence through vertexes[].cached and .completed,
#   with at least one successful completion required to avoid passing an unrecognized log
#
# example: {"cmd":"npm run build"} matches a vertex with "name":"npm run build"
# "cached":true fails, while a completed timestamp with no error passes if no matched vertex was cached
assert_no_cache() {
  local generated_plan_json_path=$1
  local buildkit_progress_log_path=$2
  jq -e -s --slurpfile plan "$generated_plan_json_path" '
    [$plan[0].steps[].commands[]? | select(.cmd != null) | .customName // .cmd] as $commands
    | [.[].vertexes[]? | select(.name as $name | $commands | index($name))] as $execution_vertices
    | if any($execution_vertices[]; .cached == true) then
        error("--no-cache reused execution steps: " +
          ([$execution_vertices[] | select(.cached == true) | .name] | unique | join(", ")))
      elif any($execution_vertices[]; .completed != null and (.error // "") == "") then
        true
      else
        error("no completed execution steps found in no-cache log")
      end
  ' "$buildkit_progress_log_path" > /dev/null
}
