#!/usr/bin/env bash
#MISE description="Prepare an example and build with docker buildx using the frontend image"
#MISE env.EXAMPLE_PROJECT_NAME = { required = true }

set -euo pipefail

# shellcheck source=.mise/tasks/test/integration/helpers/assert-execution-cache
source "$MISE_TASK_DIR/helpers/assert-execution-cache"

example_dir="examples/$EXAMPLE_PROJECT_NAME"

echo "Testing prepare-and-frontend-buildx-build with: $example_dir"
plan_dir=$(mktemp -d -p "$TMP_DIR")

docker build -f images/alpine/frontend/Dockerfile -t railpack-frontend:local .

mise run cli prepare "$example_dir" \
  --plan-out "$plan_dir/railpack-plan.json" \
  --info-out "$plan_dir/railpack-info.json"

jq -e '.success == true' "$plan_dir/railpack-info.json" > /dev/null

# Provide placeholders through files so secret names cannot overwrite the task environment.
jq -r '.secrets[]?' "$plan_dir/railpack-plan.json" > "$plan_dir/secrets.txt"
printf '%s' cli-e2e > "$plan_dir/secret-value"
secret_args=()
while IFS= read -r secret; do
  secret_args+=(--secret "id=$secret,src=$plan_dir/secret-value")
done < "$plan_dir/secrets.txt"

github_token_args=()
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  github_token_args+=(--build-arg "github-token=$GITHUB_TOKEN")
fi
# populate the cache, verify an ordinary build reuses it, then verify --no-cache reruns commands
for pass in warm cached no-cache; do
  cache_args=()
  if [[ "$pass" == no-cache ]]; then
    cache_args+=(--no-cache)
  fi
  docker buildx build \
    "${github_token_args[@]}" \
    --build-arg BUILDKIT_SYNTAX="railpack-frontend:local" \
    "${secret_args[@]}" "${cache_args[@]}" \
    --progress rawjson -f "$plan_dir/railpack-plan.json" \
    "$example_dir" 2> "$plan_dir/$pass.jsonl" || {
      cat "$plan_dir/$pass.jsonl" >&2
      exit 1
    }
  cat "$plan_dir/$pass.jsonl"
  if [[ "$pass" == cached ]]; then
    assert_execution_cache "$plan_dir/railpack-plan.json" "$plan_dir/$pass.jsonl" true
  elif [[ "$pass" == no-cache ]]; then
    assert_execution_cache "$plan_dir/railpack-plan.json" "$plan_dir/$pass.jsonl" false
  fi
done
