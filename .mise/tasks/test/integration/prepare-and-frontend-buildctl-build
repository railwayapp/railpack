#!/usr/bin/env bash
#MISE description="Build frontend image, push to local registry, prepare example, and build via buildctl"

set -euo pipefail

# Fix the example so we can assert that --previous and --start-cmd survive the
# prepare -> frontend build -> container run path. node-bun leaves Node unpinned
# and normally runs Bun, so `node -v` verifies both overrides in one short-lived run.
# It also builds without app-specific secrets or external services; this task
# does not load test.json envs, and placeholders cannot satisfy every random app.
example_name="node-bun"
example_dir="examples/$example_name"
image_name="test-buildctl-build:$example_name"
previous_node="22.22.0"
start_cmd="node -v"

if [[ ! -d "$example_dir" ]]; then
  echo "Example directory not found: $example_dir" >&2
  exit 1
fi

echo "Testing prepare-and-frontend-buildctl-build with: $example_dir"
plan_dir=$(mktemp -d -p "$TMP_DIR")

mise run image-frontend-build

# test.json pins Node via RAILPACK_NODE_VERSION for the example's own integration
# test. Omit that override here so --previous is what selects the Node version.
mise run cli prepare "$example_dir" \
  --previous "node@$previous_node" \
  --start-cmd "$start_cmd" \
  --plan-out "$plan_dir/railpack-plan.json" \
  --info-out "$plan_dir/railpack-info.json"

jq -e '.success == true' "$plan_dir/railpack-info.json" > /dev/null

jq -e '.resolvedPackages.node.source == "previous installed version"' "$plan_dir/railpack-info.json" > /dev/null
jq -e --arg ver "$previous_node" '.resolvedPackages.node.resolvedVersion == $ver' "$plan_dir/railpack-info.json" > /dev/null
jq -e --arg cmd "$start_cmd" '.deploy.startCommand == $cmd' "$plan_dir/railpack-plan.json" > /dev/null

# Provide placeholders through files so secret names cannot overwrite the task environment.
jq -r '.secrets[]?' "$plan_dir/railpack-plan.json" > "$plan_dir/secrets.txt"
printf '%s' cli-e2e > "$plan_dir/secret-value"
secret_args=()
while IFS= read -r secret; do
  secret_args+=(--secret "id=$secret,src=$plan_dir/secret-value")
done < "$plan_dir/secrets.txt"

# Pass GITHUB_TOKEN to prevent GitHub API rate-limiting (HTTP 403) when mise downloads packages
github_token_args=()
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  github_token_args+=(--opt "build-arg:github-token=$GITHUB_TOKEN")
fi

# buildctl runs inside the BuildKit container, so it cannot see the host tag railpack-frontend:local.
# It pulls the frontend from the local registry. The buildx task uses that host tag directly.
buildctl build \
  --frontend=gateway.v0 \
  --opt source=host.docker.internal:7890/railpack-frontend:local \
  "${github_token_args[@]}" \
  --local "context=$example_dir" \
  --local "dockerfile=$plan_dir" \
  --progress=plain \
  "${secret_args[@]}" \
  --output "type=docker,name=$image_name" | docker load

# v22.22.0 means --previous survived the frontend build. "hello from Bun" would mean
# the start command was still `bun index.ts`.
output=$(docker run --rm "$image_name")
echo "$output"
[[ "$output" == "v$previous_node" ]]
