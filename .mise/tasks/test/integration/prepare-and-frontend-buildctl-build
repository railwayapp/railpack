#!/usr/bin/env bash
#MISE description="Build frontend image, push to local registry, prepare example, and build via buildctl"

set -euo pipefail

docker build -f images/alpine/frontend/Dockerfile -t railpack-frontend:local .
docker tag railpack-frontend:local localhost:7890/railpack-frontend:local
docker push localhost:7890/railpack-frontend:local

# cli-e2e pins this to node-bun so the --previous and --start-cmd checks below are observable.
example_dir="examples/$EXAMPLE_PROJECT_NAME"
echo "Testing prepare-and-frontend-buildctl-build with: $example_dir"

plan_dir="tmp/test-integration/prepare-and-frontend-buildctl-build"
image_name="test-buildctl-build:$EXAMPLE_PROJECT_NAME"
mkdir -p "$plan_dir"

prepare_args=()
if [[ "$EXAMPLE_PROJECT_NAME" == "node-bun" ]]; then
  # node-bun does not pin Node, and its default command (`bun index.ts`) prints "hello from Bun".
  # 22.22.0 is the Node version that example's own test installs. --previous keeps it as a
  # previously resolved default instead of whatever the provider default is now.
  # --start-cmd replaces the bun script so the image prints the Node version.
  previous_node="22.22.0"
  start_cmd="node -v"
  prepare_args+=(--previous "node@$previous_node" --start-cmd "$start_cmd")
fi

mise run cli prepare "$example_dir" \
  "${prepare_args[@]}" \
  --plan-out "$plan_dir/railpack-plan.json" \
  --info-out "$plan_dir/railpack-info.json"

jq -e '.success == true' "$plan_dir/railpack-info.json" > /dev/null

if [[ "$EXAMPLE_PROJECT_NAME" == "node-bun" ]]; then
  jq -e '.resolvedPackages.node.source == "previous installed version"' "$plan_dir/railpack-info.json" > /dev/null
  jq -e --arg ver "$previous_node" '.resolvedPackages.node.resolvedVersion | startswith($ver)' "$plan_dir/railpack-info.json" > /dev/null
  jq -e --arg cmd "$start_cmd" '.deploy.startCommand == $cmd' "$plan_dir/railpack-plan.json" > /dev/null
fi

# The plan names secrets but not their values. Any placeholder satisfies the mount.
secret_args=()
while IFS= read -r secret; do
  export "$secret=cli-e2e"
  secret_args+=(--secret "id=$secret,env=$secret")
done < <(jq -r '.secrets[]?' "$plan_dir/railpack-plan.json")

# Pass GITHUB_TOKEN to prevent GitHub API rate-limiting (HTTP 403) when mise downloads packages
github_token_args=()
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  github_token_args+=(--opt "build-arg:github-token=$GITHUB_TOKEN")
fi

# buildctl runs inside the BuildKit container, so it cannot see the host tag railpack-frontend:local.
# It pulls the frontend from the local registry. The buildx task uses that host tag directly.
buildctl build \
  --frontend=gateway.v0 \
  --opt source=host.docker.internal:7890/railpack-frontend:local \
  "${github_token_args[@]}" \
  --local "context=$example_dir" \
  --local "dockerfile=$plan_dir" \
  --progress=plain \
  "${secret_args[@]}" \
  --output "type=docker,name=$image_name" | docker load

if [[ "$EXAMPLE_PROJECT_NAME" == "node-bun" ]]; then
  # v22.22.0 means --previous survived the frontend build. "hello from Bun" would mean
  # the start command was still `bun index.ts`.
  output=$(docker run --rm "$image_name")
  echo "$output"
  [[ "$output" == *v${previous_node}* ]]
  [[ "$output" != *"hello from Bun"* ]]
fi
