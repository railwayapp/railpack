{
 "deploy": {
  "base": {
   "image": "ghcr.io/railwayapp/railpack-runtime:mise-2026.8.5"
  },
  "inputs": [
   {
    "include": [
     "."
    ],
    "step": "defaultsToUsing"
   },
   {
    "include": [
     "."
    ],
    "step": "usesSecrets"
   }
  ],
  "startCommand": "echo secrets-build-succeeded",
  "variables": {
   "RAILPACK_VERSION": "dev"
  }
 },
 "secrets": [
  "HELLO_WORLD",
  "MY_SECRET",
  "MY_OTHER_SECRET"
 ],
 "steps": [
  {
   "inputs": [
    {
     "image": "ghcr.io/railwayapp/railpack-builder:mise-2026.8.5"
    }
   ],
   "name": "packages:mise"
  },
  {
   "commands": [
    {
     "dest": ".",
     "src": "."
    },
    {
     "cmd": "sh -c './run.sh HELLO_WORLD NOT_SECRET'",
     "customName": "./run.sh HELLO_WORLD NOT_SECRET"
    }
   ],
   "inputs": [
    {
     "step": "packages:mise"
    }
   ],
   "name": "defaultsToUsing",
   "secrets": [
    "HELLO_WORLD"
   ],
   "variables": {
    "NOT_SECRET": "not secret"
   }
  },
  {
   "commands": [
    {
     "dest": ".",
     "src": "."
    },
    {
     "cmd": "sh -c './run.sh MY_SECRET MY_OTHER_SECRET NOT_SECRET'",
     "customName": "./run.sh MY_SECRET MY_OTHER_SECRET NOT_SECRET"
    }
   ],
   "inputs": [
    {
     "step": "packages:mise"
    }
   ],
   "name": "usesSecrets",
   "secrets": [
    "MY_SECRET",
    "MY_OTHER_SECRET"
   ],
   "variables": {
    "NOT_SECRET": "not secret"
   }
  }
 ]
}